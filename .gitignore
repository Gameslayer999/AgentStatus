# Local runtime state — never source (Agent Guideline #12)
logs/*.log
sessions.json

# Backups of the user's Claude Code config created by the installer
*.claudestatus-bak

# Build artifacts (Tauri / node, for later milestones)
app/node_modules/
app/src-tauri/target/
app/dist/

# VS Code extension build artifacts
extension/node_modules/
extension/out/
extension/*.vsix
extension/report.sh


# OS
.DS_Store

# Rust build output for the standalone hook crate (decision 068)
hooks/agentstatus-hook/target/

# The extension packages a copy of the root LICENSE at publish time (npm run copylicense)
extension/LICENSE
