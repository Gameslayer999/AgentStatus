{
  "name": "agentstatus",
  "displayName": "AgentStatus",
  "description": "Live status of this window's Claude Code sessions, in the status bar.",
  "version": "0.1.4",
  "license": "MIT",
  "publisher": "agentstatus",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentstatus.focusSession",
        "title": "AgentStatus: Focus Session"
      }
    ]
  },
  "scripts": {
    "copylicense": "cp ../LICENSE ./LICENSE",
    "compile": "tsc -p ./",
    "vscode:prepublish": "npm run copylicense && npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.85.0",
    "typescript": "^5"
  }
}
